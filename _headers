# Cloudflare Pages Headers Configuration
# Security & Performance Headers
# NOTE: Cloudflare Pages Pretty URLs strips .html from request paths,
# so /* matches all HTML pages at their clean URLs (e.g. /calculators/dog-calorie)
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-XSS-Protection: 1; mode=block
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400

# Cache static assets aggressively (overrides /* Cache-Control for these paths)
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Images - long cache
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# Sitemap & robots
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
